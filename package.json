{
  "name": "emergent-matrix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop:dev": "electron ./electron/main.js",
    "desktop:build": "electron-builder --win --x64"
  },
  "dependencies": {
    "@privy-io/react-auth": "^3.38.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "@tailwindcss/postcss": "^4",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.pnhrdgtl.desktop",
    "productName": "PNHR DGTL",
    "npmRebuild": false,
    "win": { "target": ["nsis"], "icon": "build/icon.ico" },
    "files": ["electron/**/*", "package.json"],
    "extraResources": [".next/standalone/**/*", ".next/static/**/*", "public/**/*"]
  }
}
