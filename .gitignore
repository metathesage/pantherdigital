# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify

# Generated asset scratch at the repo root (3D exports, renders, zip dumps).
# These are inputs to public/ assets, never served or imported by the app, and
# committing them bloats both the repo and every deploy upload (~300MB as of 2026-09).
# Leading slash keeps this root-only: public/** is still tracked normally.
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/*.glb
/*.gltf
/*.obj
/*.zip
/*.blend
/*.blend[0-9]

.vercel
.env*
Hi3D_Untitled_allparts_20260831_235734.glb
public/panther-procedural.glb
