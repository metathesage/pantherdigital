{
  "name": "pnthr-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "PNTHR DGTL onchain studio — LucyID (SBT), PnthrPack (ERC1155), CoinPanther (ERC20), WikiIndex. Deployable to Robinhood Chain (4663) or any EVM.",
