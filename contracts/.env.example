# Robinhood Chain (4663) — fill in before deploying or verifying.
# Never commit private keys. Values are placeholders / empty on purpose.

# HTTP(S) RPC endpoint for Robinhood Chain (4663)
ROBINHOOD_RPC_URL=

# Deployer private key (0x-prefixed). Use a throwaway hot wallet, not your vault.
PRIVATE_KEY=

# Explorer API key + browser URL for `hardhat verify` (swap when the chain explorer is known)
ROBINHOOD_EXPLORER_API_KEY=

# Confirm the production chain id (defaults to 4663)
ROBINHOOD_CHAIN_ID=4663